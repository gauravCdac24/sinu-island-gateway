# ─────────────────────────────────────────────────────────────────────────────
# SINU Island Gateway — Environment Variables Example
# Copy this file to `.env` (local) or configure your deployment environment.
# NEVER commit a file containing real passwords, IPs, or credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# Options: local | staging | production
NODE_ENV=local

# ── API Server ───────────────────────────────────────────────────────────────
# Bind host — use 0.0.0.0 in Docker/server, localhost for local dev
HOST=localhost
PORT=7000

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://sinu:your_password@localhost:5432/sinu_gateway?schema=public

# ── Frontend URLs (Vite) ─────────────────────────────────────────────────────
# These are bundled at build time. Use your server's public IP or domain.
# VITE_API_URL takes precedence (preferred for nginx proxy setups: "/api")
# VITE_API_URL=/api
VITE_API_URL_7000=http://YOUR_SERVER_IP_OR_DOMAIN:7000

# ── Public site URL (used by backend for email links) ────────────────────────
PUBLIC_SITE_URL=http://YOUR_SERVER_IP_OR_DOMAIN:3000
# Or: FRONTEND_URL=http://YOUR_SERVER_IP_OR_DOMAIN:3000

# ── Admin credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=sinu_admin
ADMIN_EMAIL=admin@sinu.edu.sb
ADMIN_PASSWORD=YourStrongAdminPassword!

# ── JWT / Token secrets ───────────────────────────────────────────────────────
# Use a long random string — e.g.: openssl rand -hex 64
ADMIN_JWT_SECRET=change_this_to_a_long_random_secret

# ── SMTP (Email notifications) ───────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
# Sender address shown in emails
SMTP_FROM="SINU Admissions <noreply@sinu.edu.sb>"
