# Copy to .env.staging on the server or rely on docker-compose environment (see docker-compose-staging.yml).
NODE_ENV=staging
HOST=0.0.0.0
PORT=7000
# Local API against Docker Postgres (map 5432): postgresql://sinu:sinu_staging@localhost:5432/sinu_gateway?schema=public
DATABASE_URL=postgresql://sinu:sinu_staging@localhost:5432/sinu_gateway?schema=public
# Optional: SMTP, admin creds, public URL for emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# PUBLIC_SITE_URL=http://YOUR_HOST:3000
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
