generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentApplication {
  id                     String           @id @default(uuid())
  fullName               String           @map("full_name")
  email                  String           @unique
  phone                  String
  phoneNormalized        String?          @map("phone_normalized")
  dateOfBirth            String           @map("date_of_birth")
  gender                 String
  nationality            String
  residentialAddress     String           @map("residential_address")
  programmes             Json
  documents              Json
  status                 String           @default("pending")
  adminRemarks           String?          @map("admin_remarks")
  reviewedAt             DateTime?        @map("reviewed_at")
  passwordHash           String?          @map("password_hash")
  mustResetPassword      Boolean          @default(false) @map("must_reset_password")
  passwordResetTokenHash String?          @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime?        @map("password_reset_expires_at")
  otpCode                String?          @map("otp_code")
  otpExpiresAt           DateTime?        @map("otp_expires_at")
  otpAttempts            Int              @default(0) @map("otp_attempts")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  sessions               StudentSession[]

  @@index([phoneNormalized])
  @@index([status])
  @@map("student_applications")
}

model StudentSession {
  id            String             @id @default(uuid())
  applicationId String             @map("application_id")
  refreshToken  String             @unique @map("refresh_token")
  expiresAt     DateTime           @map("expires_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  application   StudentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("student_sessions")
}

model PolicyFile {
  id        String   @id @default(uuid())
  filename  String
  data      Bytes
  mimetype  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([filename])
  @@map("policy_files")
}

model Programme {
  id                          String   @id @default(uuid())
  programmeCode               String   @unique @map("programme_code")
  programmeName               String   @map("programme_name")
  programmeDepartment         String?  @map("programme_department")
  programmeFaculty            String?  @map("programme_faculty")
  siqfLevel                   String?  @map("SIQF_level")
  programmeEntryRequirement   String?  @map("programme_entry_requirement")
  programmeCredits            Float?   @map("programme_credits")
  programmeYear               String?  @map("programme_year")
  programmeStudyType          String[] @default([]) @map("programme_study_type")
  programmeDescription        String?  @map("programme_description")
  programmeLocation           String   @map("programme_location")
  programmeStudyPeriod        String?  @map("programme_study_period")
  programmeEnglishRequirement String?  @map("programme_english_requirement")
  programmeLevel              String?  @map("programme_level")
  programmeUnits              String?  @map("programme_units")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("programmes")
}

model Unit {
  id               String   @id @default(uuid())
  programmeUnits   String   @unique @map("programme_units")
  unitTitle        String?  @map("unit_title")
  unitPrerequisite String?  @map("unit_prerequisite")
  unitStudyType    String[] @default([]) @map("unit_study_type")
  unitDescription  String?  @map("unit_description")
  unitStudyPeriod  String[] @default([]) @map("unit_study_period")
  unitCredits      Float?   @map("unit_credits")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("units")
}

model JobVacancy {
  id                             String    @id @default(uuid())
  vacancyNo                      String    @unique @map("vacancy_no")
  title                          String
  divisionDepartment             String    @map("division_department")
  locationCampus                 String    @map("location_campus")
  bandGrade                      String?   @map("band_grade")
  staffCategory                  String?   @map("staff_category")
  reportsTo                      String?   @map("reports_to")
  summaryOfDuties                String?   @map("summary_of_duties") @db.Text
  mainDuties                     String?   @map("main_duties") @db.Text
  dimensions                     String?   @db.Text
  generalResponsibilities        String?   @map("general_responsibilities") @db.Text
  qualificationsRequired         String?   @map("qualifications_required") @db.Text
  experienceRequired             String?   @map("experience_required") @db.Text
  minimumQualificationExperience String?   @map("minimum_qualification_experience") @db.Text
  salaryRange                    String?   @map("salary_range")
  employmentType                 String?   @map("employment_type")
  termsAndConditions             String?   @map("terms_and_conditions") @db.Text
  keySelectionCriteria           String[]  @default([]) @map("key_selection_criteria")
  closingDate                    DateTime? @map("closing_date")
  status                         String    @default("draft")
  publishedAt                    DateTime? @map("published_at")
  archivedAt                     DateTime? @map("archived_at")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([closingDate])
  @@map("job_vacancies")
}

model JobApplication {
  id                String      @id @default(uuid())
  vacancyNo         String      @map("vacancy_no")
  positionTitle     String      @map("position_title")
  facultyDepartment String      @map("faculty_department")
  email             String
  fullName          String      @map("full_name")
  formData          Json
  documents         Json
  resumeExtracted   Json?       @map("resume_extracted")
  status            String      @default("pending")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([vacancyNo])
  @@index([email])
  @@index([status])
  @@map("job_applications")
}

model TenderEoi {
  id          String              @id @default(uuid())
  referenceNo String?             @map("reference_no")
  title       String
  description String              @db.Text
  department  String
  type        String
  closingDate DateTime            @map("closing_date")
  status      String              @default("draft")
  publishedAt DateTime?           @map("published_at")
  archivedAt  DateTime?           @map("archived_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  documents   TenderEoiDocument[]

  @@index([status])
  @@index([type])
  @@index([closingDate])
  @@map("tender_eoi")
}

model TenderEoiDocument {
  id        String    @id @default(uuid())
  tenderId  String    @map("tender_id")
  slot      Int
  label     String?
  filename  String
  data      Bytes
  mimetype  String    @default("application/pdf")
  createdAt DateTime  @default(now()) @map("created_at")
  tender    TenderEoi @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([tenderId, slot])
  @@index([tenderId])
  @@map("tender_eoi_documents")
}
